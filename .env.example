# CivicSaathi AI - Environment Configuration Example
# Copy this file to .env in production

# Security
CIVICSAATHI_JWT_SECRET=civicsaathi-ai-super-secret-key-2026-hackathon
CIVICSAATHI_ENV=development

# Server Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database (Default is self-contained SQLite for local testing)
DATABASE_URL=sqlite:///./data/civicsaathi.db
# For PostgreSQL/Supabase production deployment:
# DATABASE_URL=postgresql://user:password@localhost:5432/civicsaathi

# Google Maps JavaScript & Places API (Frontend)
# Set in frontend/.env or frontend/.env.local (Required for live Google Maps & Places Autocomplete)
VITE_GOOGLE_MAPS_API_KEY=

# AI Services (Optional production keys; default heuristic fallback operates offline)
# OPENAI_API_KEY=
# GOOGLE_GENAI_API_KEY=
# SPEECH_TO_TEXT_API_KEY=
